# 공급망 공격(Shai-Hulud·ChainDrop 등 npm 웜) 대비.
# 설치 스크립트를 실행하지 않는다 — 웜은 대부분 postinstall/binding.gyp로 퍼진다.
ignore-scripts=true
# 새로 올라온 버전은 7일 지나서야 받는다. 탈취된 버전은 보통 수 시간~며칠 안에 내려간다.
# 긴급 보안 패치를 바로 받아야 하면: npm install <pkg>@<ver> --min-release-age=0
min-release-age=7
# git 저장소를 직접 가리키는 의존성은 받지 않는다.
allow-git=none
